{
  "name": "ucgames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UC Games — HTML5 game studio monorepo. Phaser 4 + TypeScript, shipped to browser game portals.",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ucgames/game-template dev",
    "build": "pnpm run --recursive --filter \"./games/*\" build",
    "preview": "pnpm --filter @ucgames/game-template preview",
    "typecheck": "pnpm run --recursive typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size-budget": "node packages/devtools/src/size-budget.ts",
    "check-licenses": "node packages/devtools/src/check-licenses.ts",
    "create-game": "node scripts/create-game.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check-licenses",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "26.2.0",
    "@ucgames/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "catalog:",
    "jsdom": "^30.0.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
