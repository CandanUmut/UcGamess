# Normalise to LF in the repository. Half this team is on Windows and CI runs on
# Linux; without this, the husky hooks get CRLF line endings and fail to execute
# there, and Prettier (configured endOfLine: lf) fights git on every commit.
* text=auto eol=lf

# Shell scripts must be LF even on a Windows checkout — a CRLF shebang line is
# not executable.
*.sh text eol=lf
.husky/* text eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Generated — collapse in diffs and exclude from language statistics.
pnpm-lock.yaml linguist-generated=true -diff
