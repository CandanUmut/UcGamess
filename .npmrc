# Games resolve workspace packages from the workspace, never the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# pnpm's default isolated node_modules already prevents a package from
# importing a dependency it never declared. That is what stops a game from
# reaching a portal SDK directly; the lint rule in packages/config is the
# second layer. Do not add shamefully-hoist here — it removes that guarantee.
strict-peer-dependencies=false
auto-install-peers=true
